# ==============================================================================
# Ricoh SNMP Monitor - Miljøvariabler (.env)
# ==============================================================================

# --- Server 1: Backend Collector Daemon ---
POLL_INTERVAL=40
SNMP_COMMUNITY=public
SNMP_TIMEOUT=3.0
MAX_WORKERS=8

# SFTP-opplasting til Server 2
SFTP_HOST=ditt-webhotell.no
SFTP_PORT=22
SFTP_USER=sftp_bruker
SFTP_PASS=hemmelig_sftp_passord
SFTP_PATH=/public_html/

# REST Logger-API på Server 2
LOGGER_URL=https://ditt-webhotell.no/api/process-printers.php
LOGGER_KEY=bytt_til_en_lang_tilfeldig_og_sikker_nokkel_her

# --- Server 2: Frontend & MariaDB Database ---
DB_HOST=db
DB_NAME=ricoh_db
DB_USER=ricoh_user
DB_PASS=ricoh_hemmelig_passord
MARIADB_ROOT_PASSWORD=root_super_passord
