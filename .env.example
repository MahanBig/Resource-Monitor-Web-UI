# Copy to .env and fill in. Never commit .env.

# Database password (any long random string).
DB_PASSWORD=change-me-to-a-long-random-password

# Shared secret between the poller and the history API (min. 16 characters).
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LOGGER_KEY=change-me-to-another-long-random-secret

# Admin page login. Create the hash with:  python3 tools/hash-password.py
# IMPORTANT: write every "$" in the hash as "$$" in this file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

TIMEZONE=Europe/Oslo
SNMP_COMMUNITY=public
POLL_INTERVAL=40
WEB_PORT=8080
