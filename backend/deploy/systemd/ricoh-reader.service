[Unit]
Description=Ricoh SNMP Collector Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/ricoh-monitor/Backend
ExecStart=/usr/bin/python3 /opt/ricoh-monitor/Backend/RicohReader.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
